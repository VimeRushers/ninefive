# Postgres
DATABASE_URL=postgresql+asyncpg://tender:tender@localhost:5432/tender_db

# DeepSeek API (OpenAI-compatible)
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_REASONING_EFFORT=low
DEEPSEEK_TIMEOUT_SECONDS=60

# Embedding model (local path or HuggingFace model name)
EMBED_MODEL=intfloat/multilingual-e5-large
# Allow deterministic hash embeddings when sentence-transformers is unavailable (dev only)
EMBED_ALLOW_FALLBACK=true

# Uploaded pricelist files
PRICELISTS_DIR=data/pricelists

# App
DEBUG=true
LOG_LEVEL=info
